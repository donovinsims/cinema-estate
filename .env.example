# Sequenzy form endpoint the early-access waitlist form (/api/early-access) posts to.
# Server-only — read directly by the route handler, never inlined into the client bundle.
# Required for the Vercel deployment — set this in the Vercel project's Environment
# Variables before deploying. Without it, the form shows a graceful "being connected"
# fallback (see app/api/early-access/route.ts).
SEQUENZY_FORM_ENDPOINT=

# Sequenzy API key used by /api/listing-plan to call Sequenzy's transactional-send and
# subscriber REST APIs directly (https://docs.sequenzy.com/api-reference). Server-only.
# Without it, the listing-plan "email my full plan" flow still returns the generated plan
# but reports deliveryStatus: "failed" instead of silently pretending to send.
SEQUENZY_API_KEY=

# Optional: Sequenzy list ID for the "Listing Plan Leads" marketing list. Only used when a
# listing-plan visitor explicitly opts into marketing (marketingConsent). If unset, no list
# enrollment happens (tags are still applied) — do not point this at the unrelated existing
# "Product Subscribers" list.
SEQUENZY_LISTING_PLAN_LIST_ID=

# PostHog analytics (app/AnalyticsConsent.tsx). Both are NEXT_PUBLIC_ vars,
# inlined into the client bundle, and only take effect after a visitor
# grants analytics consent. Set these in the Vercel project's Environment
# Variables before deploying — without NEXT_PUBLIC_POSTHOG_KEY, analytics
# init is skipped entirely (no error, just no tracking).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
